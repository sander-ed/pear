#!/usr/bin/expect -f
# End-to-end test: create, detach, list, reattach (screen restore), exit, kill.
# Usage: expect tests/e2e.exp path/to/pear

set pear [lindex $argv 0]
set timeout 10
set env(PEAR_DIR) "/tmp/pear-e2e-[pid]"
set env(PS1) "PROMPT> "
file delete -force $env(PEAR_DIR)

proc fail {msg} { puts "\nFAIL: $msg"; exit 1 }

# 1. create session running sh
spawn $pear -k "C-a d" new t1 /bin/sh
expect {
    -ex "\x1b\[?1049h" {}
    timeout { fail "did not switch to the alternate screen" }
}
expect "PROMPT>"
send "echo marker-\$((40+2))\r"
expect {
    "marker-42" {}
    timeout { fail "no echo" }
}
expect "PROMPT>"

# 2. detach with C-a d
send "\001d"
expect {
    "detached from t1" {}
    timeout { fail "no detach" }
}
wait

# 3. list shows it running
spawn $pear ls
expect {
    -re "t1\t\\d+x\\d+\t0 attached\trunning" {}
    timeout { fail "ls did not show running session" }
}
wait

# 4. reattach: the screen should be repainted with the previous output
spawn $pear attach t1
expect {
    "marker-42" {}
    timeout { fail "screen not restored on reattach" }
}
send "echo second-\$((50+5))\r"
expect {
    "second-55" {}
    timeout { fail "no echo after reattach" }
}

# 5. prefix that is not the detach key is passed through: C-a (beginning of line) then x
send "echo abc"
send "\001"
sleep 0.7
send "\r"
expect {
    "abc" {}
    timeout { fail "C-a prefix was swallowed" }
}

# 6. program exits -> client exits with its status
send "exit 3\r"
expect {
    "exited with status 3" {}
    timeout { fail "no exit status" }
}
catch wait result
if {[lindex $result 3] != 3} { fail "pear exit code was [lindex $result 3], want 3" }

# 7. session is gone
spawn $pear ls
expect {
    "no sessions" {}
    timeout { fail "session still listed after exit" }
}
wait

# 8. kill a detached session
spawn $pear -d new t2 /bin/sh -c "sleep 100"
expect "created t2"
wait
spawn $pear kill t2
expect "killed t2"
wait
sleep 0.3
spawn $pear ls
expect {
    "no sessions" {}
    timeout { fail "t2 still listed after kill" }
}
wait

# 9. alt-screen program (vi) survives detach/reattach with screen intact
set bskey "C-\\"
spawn $pear -k $bskey new v1 vi
expect {
    -re "~" {}
    timeout { fail "vi did not start" }
}
send "ihello from vi"
expect "hello from vi"
send "\034"
expect "detached from v1"
wait
spawn $pear attach v1
expect {
    "hello from vi" {}
    timeout { fail "vi screen not restored" }
}
send "\033:q!\r"
expect "exited with status 0"
wait

# 10. bare `pear` creates numbered sessions 1, 2, ...
spawn $pear
expect "PROMPT>"
send "echo in-\$PEAR\r"
expect {
    "in-1" {}
    timeout { fail "bare pear did not create session 1" }
}
expect "PROMPT>"
send "\001d"
expect "detached from 1"
wait

# 11. detach works while the program uses the kitty keyboard protocol
# (Ctrl-a arrives as ESC [ 97 ; 5 u, like inside GitHub Copilot CLI)
spawn $pear
expect "PROMPT>"
send "echo in-\$PEAR\r"
expect {
    "in-2" {}
    timeout { fail "bare pear did not create session 2" }
}
expect "PROMPT>"
send "printf '\\033\[>1u'; sleep 30\r"
sleep 0.5
send "\033\[97;5ud"
expect {
    "detached from 2" {}
    timeout { fail "kitty-encoded C-a d did not detach" }
}
wait

# 12. options after the subcommand; no orphan session when attach is impossible
spawn $pear new -d t3 /bin/sh -c "sleep 100"
expect {
    "created t3" {}
    timeout { fail "new -d NAME did not create t3" }
}
wait
spawn sh -c "$pear new t4 /bin/sh < /dev/null"
expect {
    "must be a terminal" {}
    timeout { fail "no tty error" }
}
wait
spawn $pear ls
expect {
    -re "1\t.*\n2\t.*\nt3\t" {}
    timeout { fail "unexpected session list" }
}
wait
foreach s {1 2 t3} {
    spawn $pear kill $s
    expect "killed $s"
    wait
}

# 13. kill while the program floods output must not hang
spawn $pear new -d f /bin/sh -c "yes"
expect "created f"
wait
spawn $pear kill f
expect {
    "killed f" {}
    timeout { fail "kill hung on a busy session" }
}
wait

# 14. the session is contained in the alternate screen: the program's own
# screen switches never reach the terminal, and leaving resets the modes and
# returns to the primary screen, which restores what was there before
spawn $pear new -d c1 /bin/sh -c "sleep 100"
expect "created c1"
wait
spawn $pear attach c1
expect -ex "\x1b\[?1049h"
send "\001d"
expect {
    -re "\x1b\\\[<99u.*\x1b\\\[\\?1049l.*detached from c1" {}
    timeout { fail "did not leave the alternate screen" }
}
wait
spawn $pear kill c1
expect "killed c1"
wait
spawn $pear new s1 /bin/sh
expect "PROMPT>"
send "printf 'A\\033\[?1049hB\\033\[?1049lC\\n'\r"
expect {
    -re "\x1b\\\[\\?1049\[hl\]" { fail "program's screen switch reached the terminal" }
    -re "\nAC\r" {}
    timeout { fail "output around screen switches was lost" }
}
send "exit\r"
expect "exited with status 0"
wait

# 15. `pear NAME -d -- CMD` creates NAME with a shell and types CMD into it;
# `pear NAME -- CMD` does the same and attaches
spawn $pear r1 -d -- echo sent-\$((6*7))
expect {
    "created r1: echo sent-" {}
    timeout { fail "send -d did not create r1" }
}
wait
spawn $pear r1 -d -- echo again-\$((7*7))
expect {
    "sent to r1: echo again-" {}
    timeout { fail "send -d to existing r1 failed" }
}
wait
sleep 0.5
spawn $pear attach r1
expect {
    -re "sent-42.*again-49" {}
    timeout { fail "sent commands did not run in r1" }
}
send "\001d"
expect "detached from r1"
wait
spawn $pear r1 -- echo third-\$((8*8))
expect {
    "third-64" {}
    timeout { fail "pear NAME -- CMD did not run and attach" }
}
send "exit\r"
expect "exited with status 0"
wait
spawn $pear r2 -- echo new-\$PEAR
expect {
    "new-r2" {}
    timeout { fail "pear NAME -- CMD did not create and attach" }
}
send "exit\r"
expect "exited with status 0"
wait
spawn $pear r3 -d -- true
expect "created r3"
wait
spawn $pear r3 -d -- exit
expect "sent to r3"
wait
spawn sh -c "sleep 0.5; $pear r3 -d -- true; echo rc=\$?"
expect {
    -re "created r3.*rc=0" {}
    timeout { fail "r3 should be gone after exit and be recreated" }
}
wait
spawn $pear kill r3
expect "killed r3"
wait

file delete -force $env(PEAR_DIR)
puts "\nALL OK"
